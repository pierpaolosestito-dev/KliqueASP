{
  "schemaVersion": 2,
  "features": {
    "timeline": true,
    "labelVisibilityToggle": true,
    "nodeLabelsVisibleByDefault": false,
    "aggregateParallelEdgesForDisplay": true,
    "fitGraphToView": true
  },
  "node": {
    "iconSize": 7,
    "ring": {
      "scale": 4.5
    }
  },
  "forces": {
    "nodeCollisionRadius": 7.5
  },
  "graph": {
    "linkOpacity": 0.18,
    "linkWidth": 0.4
  },
  "graphMapping": {
    "node": {
      "idField": "$.id",
      "labelField": "$.label",
      "typeField": "$.type",
      "attributes": {
        "participant": "$.id"
      }
    },
    "edge": {
      "idField": "$.id",
      "sourceField": "$.source",
      "targetField": "$.target",
      "typeField": "$.type",
      "direction": "undirected",
      "identity": "multigraph",
      "validity": {
        "fromField": "$.validFrom",
        "toField": "$.validTo",
        "numericUnit": "seconds"
      }
    }
  },
  "graphAnalysis": {
    "motifs": [
      {
        "id": "invs-temporal-contact-chain",
        "label": "Catena di quattro partecipanti con contatti in ordine temporale",
        "temporal": {
          "semantics": "orderedByStart",
          "strict": true
        },
        "roles": {
          "first": {
            "nodeTypes": [
              "person"
            ]
          },
          "second": {
            "nodeTypes": [
              "person"
            ]
          },
          "third": {
            "nodeTypes": [
              "person"
            ]
          },
          "fourth": {
            "nodeTypes": [
              "person"
            ]
          }
        },
        "edges": [
          {
            "sourceRole": "first",
            "targetRole": "second",
            "edgeType": "face-to-face-contact"
          },
          {
            "sourceRole": "second",
            "targetRole": "third",
            "edgeType": "face-to-face-contact"
          },
          {
            "sourceRole": "third",
            "targetRole": "fourth",
            "edgeType": "face-to-face-contact"
          }
        ]
      },
      {
        "id": "invs-selected-participant-gap",
